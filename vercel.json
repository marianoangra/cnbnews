{
  "framework": "hugo",
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"preview\" ]; then hugo --minify -b \"https://$VERCEL_URL/\"; else hugo --minify; fi",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<city>[a-z0-9-]+)[.]news[.]cnbmobile[.]com"
        }
      ],
      "dest": "/cidades/$city/$1",
      "check": true
    },
    {
      "handle": "filesystem"
    }
  ]
}
