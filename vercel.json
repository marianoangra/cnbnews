{
  "framework": "hugo",
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"preview\" ]; then hugo --minify -b \"https://$VERCEL_URL/\"; else hugo --minify; fi",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/aovivo.json",
      "dest": "https://rig1660s.tail4a859f.ts.net/cnb-admin/api/aovivo"
    },
    {
      "src": "/admin",
      "status": 308,
      "headers": {
        "Location": "/admin/"
      }
    },
    {
      "src": "/admin/api/(.*)",
      "dest": "https://rig1660s.tail4a859f.ts.net/cnb-admin/api/$1",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/delete-account/?",
      "status": 308,
      "headers": {
        "Location": "https://www.usejuicemobile.com/delete-account"
      }
    },
    {
      "src": "/(suporte|faq)/?",
      "status": 308,
      "headers": {
        "Location": "https://www.usejuicemobile.com/$1"
      }
    },
    {
      "src": "/((?!admin|api/|ads[.]txt|aovivo[.]json).*)",
      "has": [
        {
          "type": "host",
          "value": "^(www[.])?cnbmobile[.]com$"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://news.cnbmobile.com/$1"
      }
    },
    {
      "src": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "(?<city>[a-z0-9-]+)[.]news[.]cnbmobile[.]com"
        }
      ],
      "dest": "/cidades/$city/$1",
      "check": true
    },
    {
      "handle": "filesystem"
    }
  ],
  "crons": [
    {
      "path": "/api/resumo-diario",
      "schedule": "0 10 * * *"
    }
  ],
  "functions": {
    "api/resumo-diario.mjs": {
      "maxDuration": 60
    }
  }
}
