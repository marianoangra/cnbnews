{
  "framework": "hugo",
  "buildCommand": "hugo --minify",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?<city>[a-z0-9-]+)[.]news[.]cnbmobile[.]com"
        }
      ],
      "destination": "/cidades/:city/:path*"
    }
  ]
}
