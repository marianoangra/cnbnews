{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{/* Sitemap principal com as URLs CANÔNICAS (a mesma do <link rel=canonical> de cada página):
     cidades no subdomínio <slug>.news.cnbmobile.com, nacionais em news.cnbmobile.com/noticias/.
     URLs de outros hosts só valem com a propriedade de DOMÍNIO cnbmobile.com no Search Console. */}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ "/" | absURL }}</loc>
    <changefreq>hourly</changefreq>
    <priority>1.0</priority>
  </url>
  {{ with site.GetPage "/noticias" }}
  <url>
    <loc>{{ .Permalink }}</loc>
    <changefreq>hourly</changefreq>
    <priority>0.9</priority>
  </url>
  {{ end }}
  {{ range where site.RegularPages "Section" "noticias" }}
  <url>
    <loc>{{ .Permalink }}</loc>
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>0.8</priority>
  </url>
  {{ end }}
  {{ with site.GetPage "/colunas" }}
  <url>
    <loc>{{ .Permalink }}</loc>
    <changefreq>daily</changefreq>
    <priority>0.7</priority>
  </url>
  {{ end }}
  {{ range where site.RegularPages "Section" "colunas" }}
  <url>
    <loc>{{ .Permalink }}</loc>
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  {{ end }}
  {{ with site.GetPage "/cidades" }}
    {{ range .Sections }}
      {{ $slug := path.Base (strings.TrimSuffix "/" .RelPermalink) }}
  <url>
    <loc>https://{{ $slug }}.{{ site.Params.baseDomain }}/</loc>
    <changefreq>hourly</changefreq>
    <priority>0.9</priority>
  </url>
    {{ end }}
  {{ end }}
  {{ range where site.RegularPages "Section" "cidades" }}
    {{ $cslug := path.Base (strings.TrimSuffix "/" .Parent.RelPermalink) }}
  <url>
    <loc>https://{{ $cslug }}.{{ site.Params.baseDomain }}/{{ path.Base .RelPermalink }}/</loc>
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>0.8</priority>
  </url>
  {{ end }}
  {{ range where site.RegularPages "Section" "in" (slice "sobre" "contato" "privacidade" "termos") }}
  <url>
    <loc>{{ .Permalink }}</loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
  {{ end }}
</urlset>
