{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://sitemaps.org">
  <url>
    <loc>https://cnbmobile.com</loc>
    <changefreq>hourly</changefreq>
    <priority>1.0</priority>
  </url>
  {{ with site.GetPage "/cidades" }}
    {{ range .Sections }}
      {{ $slug := path.Base (strings.TrimSuffix "/" .RelPermalink) }}
      <url>
        <loc>https://{{ $slug }}.{{ site.Params.baseDomain }}/</loc>
        <changefreq>hourly</changefreq>
        <priority>0.9</priority>
      </url>
    {{ end }}
  {{ end }}
  {{ range where .Site.RegularPages "Section" "cidades" }}
    {{ $cslug := path.Base (strings.TrimSuffix "/" .Parent.RelPermalink) }}
    {{ $pslug := path.Base .RelPermalink }}
    <url>
      <loc>https://{{ $cslug }}.{{ site.Params.baseDomain }}/{{ $pslug }}/</loc>
      <lastmod>{{ .Date.Format "2006-01-02T15:04:05-03:00" }}</lastmod>
      <changefreq>daily</changefreq>
      <priority>0.8</priority>
    </url>
  {{ end }}
</urlset>
