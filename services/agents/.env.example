# Copie para .env (fica fora do git) e ajuste na rig.
OLLAMA_ENDPOINT=http://localhost:11434
# Mesmo modelo e num_ctx do robo_cnb.py — se divergir, o Ollama recarrega o modelo a cada troca.
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=4096
# Tempo máximo por chamada ao modelo (ms). 10 min: logo após o boot o modelo leva
# >90 s para carregar do pendrive, e se o cliente desiste o Ollama aborta o carregamento.
OLLAMA_TIMEOUT_MS=600000
# Só se o Ollama estiver atrás de um gateway com token
OLLAMA_TOKEN=
