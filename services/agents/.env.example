# Copie para .env (fica fora do git) e ajuste na rig.
#
# DUAL-GPU: uma instância do Ollama por placa, cada uma com UM modelo fixo.
#   GPU 0 · RTX 3060 12 GB → redação, revisão, SEO, colunista
#     CUDA_VISIBLE_DEVICES=0 OLLAMA_HOST=127.0.0.1:11434 ollama serve
#   GPU 1 · RTX 2060 6 GB  → triagem de sensibilidade, lauda da live/rádio (+ NVENC da live)
#     CUDA_VISIBLE_DEVICES=1 OLLAMA_HOST=127.0.0.1:11435 ollama serve
#   Use CUDA_DEVICE_ORDER=PCI_BUS_ID nas duas para o índice bater com o nvidia-smi.
# Se a 11435 não responder, as etapas rápidas rodam na 11434 (a matéria não para).
OLLAMA_HEAVY_URL="http://localhost:11434"
OLLAMA_HEAVY_MODEL="qwen2.5:14b-instruct-q4_K_M"
OLLAMA_HEAVY_NUM_CTX=8192
OLLAMA_FAST_URL="http://localhost:11435"
OLLAMA_FAST_MODEL="qwen2.5:3b-instruct"
OLLAMA_FAST_NUM_CTX=4096
# GPU do encoder NVENC da live 24h (lido pelo stream-engine)
FFMPEG_GPU_DEVICE=1
# Tempo máximo por chamada ao modelo (ms). 10 min: logo após o boot o modelo leva
# minutos para carregar do pendrive, e se o cliente desiste o Ollama aborta o carregamento.
OLLAMA_TIMEOUT_MS=600000
# Só se o Ollama estiver atrás de um gateway com token
OLLAMA_TOKEN=
# Compatibilidade: sem as OLLAMA_HEAVY_*, valem OLLAMA_ENDPOINT/OLLAMA_MODEL/OLLAMA_NUM_CTX.
