# Chave da transmissão (YouTube Studio > Transmitir). NUNCA commitar.
YOUTUBE_STREAM_KEY=
# Opcional: sobrescreve o destino (ex.: data/teste.flv para testar sem YouTube)
DESTINO=
# Índice da GPU do NVENC (ordem PCI, igual ao nvidia-smi). Rig: 1 (RTX 2060). Este PC: 0.
FFMPEG_GPU_DEVICE=1
# Voz da locução (edge-tts)
TTS_VOZ=pt-BR-FranciscaNeural
